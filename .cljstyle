{:files
 {:ignore #{"target" ".direnv" ".git" "transformer-dojo/docs" "transformer-dojo/tests"}}

 :rules
 {:indentation {:list-indent 1}
  :blank-lines {:max-consecutive 1
                :padding-lines 0}
  :vars {:enabled? false}
  :functions {:enabled? false}
  :types {:enabled? false}
  :namespaces {:indent-size 1}}}
